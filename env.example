# Database
DATABASE_URL="postgresql://dbuser:dbpass@localhost:5432/db_name?schema=public"

# OpenRouter AI
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nousresearch/hermes-4-405b"

# Script Generation Models (comma separated)
SCRIPT_MODEL_1="nousresearch/hermes-4-405b"
SCRIPT_MODEL_2="google/gemma-3-27b-it:free"
SCRIPT_MODEL_3="arcee-ai/trinity-large-preview:free"

# Image Generation Service Type
# Options:
# - 'kei' = Kei.ai (default, async with callback)
# - 'local' = Local Automatic1111/ComfyUI/Fooocus
# - 'replicate' = Replicate.com cloud API
# - 'pollinations' = Pollinations.ai (free, optional API key for higher limits)
IMAGE_SERVICE_TYPE="pollinations"

# Pollinations.ai Settings (for IMAGE_SERVICE_TYPE=pollinations)
# API key is optional - leave empty for free tier with rate limits
# Get key from: https://pollinations.ai/
POLLINATIONS_API_KEY=""

# Scene duration configuration (in seconds)
SCENE_MIN_DURATION=4
SCENE_MAX_DURATION=8
LONGFORM_SCENE_MIN_DURATION=6
LONGFORM_SCENE_MAX_DURATION=12

# YouTube Channel Configuration
YOUTUBE_CHANNEL_ID=""
YOUTUBE_CHANNEL_NAME=""
YOUTUBE_DEFAULT_PRIVACY="private"  # public, unlisted, private
YOUTUBE_DEFAULT_CATEGORY="22"      # 22 = People & Blogs

# Local Image Settings (for IMAGE_SERVICE_TYPE=local)
LOCAL_IMAGE_API_URL="http://localhost:7860"
LOCAL_IMAGE_API_TYPE="automatic1111"  # automatic1111, comfyui, fooocus
LOW_VRAM_MODE="false"  # For GPUs with <8GB VRAM (RX560, GTX 1060)

# Replicate Settings (for IMAGE_SERVICE_TYPE=replicate)
REPLICATE_API_TOKEN=""

# Azure Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=