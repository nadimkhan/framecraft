# ───────────────────────────────────────────────────────────────────────────
# Social Media OAuth — required for the "Connect YouTube / Instagram" feature
# ───────────────────────────────────────────────────────────────────────────

# YouTube Data API v3 — Google Cloud Console → APIs & Services → Credentials
#   1. https://console.cloud.google.com → create a project (or pick existing)
#   2. APIs & Services → Library → enable "YouTube Data API v3"
#   3. APIs & Services → Credentials → Create OAuth client ID
#      - Application type: Web application
#      - Authorized redirect URI: http://localhost:3000/api/oauth/youtube/callback
#        (add your production URL too when deploying)
#   4. Copy Client ID + Client secret below
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# Instagram (Meta Graph API via Facebook Login)
#   1. https://developers.facebook.com/apps → Create app → "Business"
#   2. Add product → "Facebook Login for Business"
#   3. Settings → Valid OAuth Redirect URIs: http://localhost:3000/api/oauth/instagram/callback
#   4. App Review → request these permissions:
#        pages_show_list, pages_manage_posts,
#        instagram_basic, instagram_content_publish,
#        public_profile, email
#   5. Settings → Basic → copy App ID + App secret below
INSTAGRAM_OAUTH_APP_ID=
INSTAGRAM_OAUTH_APP_SECRET=

# Public URL of this app — used to build OAuth callback URLs. For local dev
# leave it as http://localhost:3000. In production set this to https://your.domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32-byte hex secret for encrypting OAuth tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this set, tokens are stored in plaintext (DEV ONLY — not safe).
SOCIAL_TOKEN_ENC_KEY=
